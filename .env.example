# Nukopijuokite šį failą į .env ir užpildykite reikšmes.
# .env niekada nekelkite į GitHub.

# --- AI analizė (užtenka vieno iš dviejų) ---
OPENAI_API_KEY=sk-jusu-raktas
OPENAI_MODEL=gpt-4o-mini

# Jei OPENAI_API_KEY tuščias, naudojamas Claude:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- El. paštas (SMTP). Palikite tuščią, jei siųsti nereikia. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jusu.pastas@gmail.com
SMTP_PASSWORD=gmaillo-programos-slaptazodis
EMAIL_FROM=jusu.pastas@gmail.com
EMAIL_TO=gavejas@pavyzdys.lt
EMAIL_SUBJECT=AI verslo tendencijų ataskaita
